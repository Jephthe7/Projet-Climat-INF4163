# Copier ce fichier en .env et remplir les vraies valeurs.
# .env ne doit JAMAIS etre commite (deja exclu par le .gitignore racine).

# Valeurs de PRODUCTION (Azure SQL Database) :
DB_SERVER=climat-inf4163-sql.database.windows.net
DB_USER=api_climat
DB_PASSWORD=
DB_PORT=1433
DB_TRUST_SERVER_CERTIFICATE=false
DB_ENCRYPT=true

# Pour developper en local contre SQL Server Express a la place, remplacer
# temporairement les 6 lignes ci-dessus par :
#   DB_SERVER=NOM_DE_TON_INSTANCE\SQLEXPRESS
#   DB_USER=api_climat
#   DB_PASSWORD=
#   DB_PORT=1433
#   DB_TRUST_SERVER_CERTIFICATE=true
#   DB_ENCRYPT=false

PORT=3000
